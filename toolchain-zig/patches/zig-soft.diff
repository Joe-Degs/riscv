+fn udivmod_soft(a: u64, b: u64, maybe_rem: ?*u64) u64 {
+    var q: u64 = 0;
+    var r: u64 = 0;
+    var i: u7 = 64;
+    while (i > 0) {
+        i -= 1;
+        const carry = r >> 63;
+        r = (r << 1) | ((a >> @intCast(i)) & 1);
+        if (carry != 0 or r >= b) {
+            r -%= b;
+            q |= @as(u64, 1) << @intCast(i);
+        }
+    }
+    if (maybe_rem) |rem| rem.* = r;
+    return q;
+}
+
+fn __udivmoddi4_soft(a: u64, b: u64, maybe_rem: ?*u64) callconv(.c) u64 {
+    return udivmod_soft(a, b, maybe_rem);
+}
+
+fn __udivdi3_soft(a: u64, b: u64) callconv(.c) u64 {
+    return udivmod_soft(a, b, null);
+}
+
+fn __umoddi3_soft(a: u64, b: u64) callconv(.c) u64 {
+    var r: u64 = undefined;
+    _ = udivmod_soft(a, b, &r);
+    return r;
+}
+
+fn __divdi3_soft(a: i64, b: i64) callconv(.c) i64 {
+    const sign: u64 = @bitCast((a ^ b) >> 63);
+    const abs_a = (a ^ (a >> 63)) -% (a >> 63);
+    const abs_b = (b ^ (b >> 63)) -% (b >> 63);
+    const res = udivmod_soft(@bitCast(abs_a), @bitCast(abs_b), null);
+    return @bitCast((res ^ sign) -% sign);
+}
+
+fn __moddi3_soft(a: i64, b: i64) callconv(.c) i64 {
+    const abs_a = (a ^ (a >> 63)) -% (a >> 63);
+    const abs_b = (b ^ (b >> 63)) -% (b >> 63);
+    var r: u64 = undefined;
+    _ = udivmod_soft(@bitCast(abs_a), @bitCast(abs_b), &r);
+    return (@as(i64, @bitCast(r)) ^ (a >> 63)) -% (a >> 63);
+}
+
+fn __divmoddi4_soft(a: i64, b: i64, rem: *i64) callconv(.c) i64 {
+    const d = __divdi3_soft(a, b);
+    rem.* = __moddi3_soft(a, b);
+    return d;
+}
