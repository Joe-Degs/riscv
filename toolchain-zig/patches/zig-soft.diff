+/// Operations with no hardware instruction on this target, which compiler_rt must
+/// implement without emitting the operation it implements.
+pub const want_soft = struct {
+    const riscv = builtin.cpu.arch.isRISCV();
+    pub const mul = riscv and !builtin.cpu.hasAny(.riscv, &.{ .m, .zmmul });
+    pub const div = riscv and !builtin.cpu.has(.riscv, .m);
+    /// Assumes a single hart with no preemption: locks become no-ops.
+    pub const atomics = riscv and !builtin.cpu.has(.riscv, .a);
+};
